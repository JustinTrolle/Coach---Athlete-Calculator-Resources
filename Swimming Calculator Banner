<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Swim Pace and Training Zone Calculator | USA Triathlon</title>
<style>
  /* ---------- USA Triathlon brand tokens ---------- */
  :root {
    --usat-red:        #A80C34;
    --usat-blue:       #002A5C;
    --usat-blue-dark:  #001F47;
    --usat-white:      #FFFFFF;
    --usat-gray-dark:  #1A1A1A;
    --usat-gray-mid:   #4A4A4A;
    --usat-gray-light: #F2F2F2;
    --usat-gray-border:#CCCCCC;
    --usat-red-tint:   #F5E0E5;
    --usat-blue-tint:  #E6EAF0;

    --font-heading: "Univers Black", "Arial Black", Impact, sans-serif;
    --font-body:    "Univers Roman", Arial, Helvetica, sans-serif;
    --font-light:   "Univers Light", "Arial Narrow", Arial, sans-serif;
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--usat-gray-light); }
  .rzc { font-family: var(--font-body); color: var(--usat-gray-dark); line-height: 1.5; }
  .rzc h1, .rzc h2, .rzc p { margin: 0; }
  .rzc a { color: inherit; }

  /* One copy of the photo, shared by the hero and the video poster */
  .rzc-photo, .rzc-video {
    background-image: url("data:image/jpeg;base64,");
    background-repeat: no-repeat;
    background-size: cover;
  }

  /* ---------- Top bar (solid band keeps the logo legible) ---------- */
  .rzc-top { background: var(--usat-blue); color: #fff; }
  .rzc-top-in {
    max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 56px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .rzc-brand { font-family: var(--font-heading); font-size: 1.05rem; text-decoration: none; color: #fff; }
  /* To use the official logo: replace the text inside .rzc-brand with
     <img src="YOUR-USAT-LOGO-WHITE.svg" alt="USA Triathlon" height="28"> */
  .rzc-top nav a {
    font-family: var(--font-heading); font-size: .9rem; color: #fff;
    text-decoration: none; margin-left: 24px; opacity: .92;
  }
  .rzc-top nav a:hover { text-decoration: underline; text-underline-offset: 4px; opacity: 1; }

  /* ---------- Hero ---------- */
  .rzc-hero { min-height: 680px; position: relative; overflow: hidden; isolation: isolate; background: var(--usat-blue-dark); color: #fff; }
  .rzc-photo-wrap {
    position: absolute; inset: -28px; z-index: -3;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform .3s ease-out;
  }
  .rzc-photo {
    position: absolute; inset: 0;
    background-position: 74% 62%;
    animation: rzc-drift 34s ease-in-out infinite alternate;
  }
  @keyframes rzc-drift { from { transform: scale(1); } to { transform: scale(1.09); } }

  /* Legibility scrim: deep USAT blue on the copy side, photo opens up on the right */
  .rzc-scrim {
    position: absolute; inset: 0; z-index: -2;
    background: linear-gradient(90deg,
      rgba(0,31,71,.95) 0%, rgba(0,31,71,.88) 42%, rgba(0,31,71,.34) 66%, rgba(0,31,71,.08) 100%);
  }

  /* Track lanes draw in once on load */
  .rzc-lanes { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .rzc-lanes path {
    fill: none; stroke: rgba(255,255,255,.38); stroke-width: 2; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: rzc-draw 2.2s cubic-bezier(.3,.7,.2,1) forwards;
    animation-delay: calc(.2s + var(--n) * .16s);
  }
  .rzc-lanes path.lead { stroke: var(--usat-red); stroke-width: 3; }
  @keyframes rzc-draw { to { stroke-dashoffset: 0; } }

  .rzc-hero-in {
    max-width: 1200px; margin: 0 auto; padding: 84px 24px 152px;
  }
  .rzc-copy { max-width: 600px; }
  .rzc h1 {
    font-family: var(--font-heading); font-weight: 900;
    font-size: clamp(2.2rem, 5.2vw, 3.5rem); line-height: 1.02; letter-spacing: -.02em; color: #fff;
  }
  .rzc .rzc-lede { margin-top: 22px; font-size: 1.15rem; max-width: 480px; color: rgba(255,255,255,.88); }

  .rzc .rzc-byline {
    margin-top: 18px; padding-left: 12px; border-left: 3px solid var(--usat-red);
    font-family: var(--font-light); font-size: .95rem; color: rgba(255,255,255,.9);
  }
  .rzc-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .rzc-btn {
    display: inline-flex; align-items: center; min-height: 48px; padding: 12px 26px; line-height: 1.3;
    border-radius: 4px; font-family: var(--font-heading); font-size: .95rem;
    text-decoration: none; border: 2px solid transparent; cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease, color .15s ease;
  }
  .rzc-btn-primary { background: var(--usat-red); color: #fff; }
  .rzc-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,.35); }
  .rzc-btn-ghost { border-color: #fff; color: #fff; background: transparent; }
  .rzc-btn-ghost:hover { background: #fff; color: var(--usat-blue); }

  /* Seven-zone staircase */
  .rzc-zones { --w: 44px; position: relative; display: flex; align-items: flex-end; gap: 6px; margin-top: 20px; padding-top: 56px; width: fit-content; }
  .rzc-mk {
    position: absolute; top: 30px; bottom: calc(25px + var(--bh) + 4px); width: 2px; background: var(--usat-red);
    left: calc(var(--k) * var(--w) + (var(--k) - 1) * 6px + 2px);
    filter: drop-shadow(0 0 1.5px rgba(255,255,255,.9));
    animation: rzc-fade .6s ease backwards; animation-delay: 1.5s;
  }
  .rzc-mk::after {
    content: ""; position: absolute; left: 50%; bottom: -6px; transform: translateX(-50%);
    border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 8px solid var(--usat-red);
  }
  .rzc-mk b {
    position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 5px;
    font-family: var(--font-heading); font-weight: 900; font-size: .85rem; line-height: 1; color: #fff; white-space: nowrap;
  }
  @keyframes rzc-fade { from { opacity: 0; } }
  .rzc-zones span { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .rzc-zones i {
    display: block; width: var(--w); height: var(--h); background: #fff; opacity: var(--o);
    transform-origin: bottom; border-radius: 2px 2px 0 0;
    animation: rzc-rise .7s cubic-bezier(.2,.8,.2,1) backwards;
    animation-delay: calc(.6s + var(--i) * .08s);
    transition: transform .2s ease, opacity .2s ease;
  }
  .rzc-zones span:hover i { transform: translateY(-5px); opacity: 1; }
  .rzc-zones span b { font-family: var(--font-light); font-weight: 400; font-size: .8rem; color: rgba(255,255,255,.85); }
  @keyframes rzc-rise { from { transform: scaleY(0); } }

  /* ---------- Resource panel ---------- */
  .rzc-wrap { padding: 0 24px 56px; }
  .rzc-panel {
    position: relative; z-index: 2; max-width: 1152px; margin: -80px auto 0; background: #fff;
    border-radius: 4px; padding: 36px; box-shadow: 0 14px 36px rgba(0,31,71,.22);
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 44px;
  }
  .rzc h2 { font-family: var(--font-heading); font-weight: 900; font-size: 1.7rem; line-height: 1.15; letter-spacing: -.01em; color: var(--usat-blue); margin-bottom: 18px; }
  .rzc .meta { font-family: var(--font-light); font-size: .85rem; color: var(--usat-gray-mid); margin-top: 12px; }

  /* Video slot */
  .rzc-video {
    position: relative; aspect-ratio: 16 / 9; border-radius: 4px; overflow: hidden;
    background-color: var(--usat-blue-dark); background-position: 80% 60%;
  }
  .rzc-video::before { content: ""; position: absolute; inset: 0; background: rgba(0,31,71,.66); }
  .rzc-video iframe, .rzc-video video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; z-index: 2; }
  .rzc-play {
    position: absolute; z-index: 1; top: 50%; left: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px;
    border-radius: 50%; border: 0; background: #fff; cursor: pointer; display: grid; place-items: center;
    transition: transform .18s ease;
  }
  .rzc-play:hover { transform: scale(1.08); }
  .rzc-play svg { width: 30px; height: 30px; margin-left: 5px; fill: var(--usat-blue); }
  .rzc-video-note {
    position: absolute; z-index: 1; left: 16px; right: 16px; bottom: 12px;
    font-family: var(--font-light); font-size: .8rem; color: rgba(255,255,255,.85);
  }

  /* Download list */
  .rzc-dl { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .rzc-file {
    display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 14px;
    padding: 14px 16px; text-decoration: none; background: #fff;
    border: 1px solid var(--usat-gray-border); border-left: 4px solid var(--usat-blue); border-radius: 4px;
    transition: background-color .15s ease, border-left-color .15s ease, transform .15s ease;
  }
  .rzc-file:hover { background: var(--usat-blue-tint); border-left-color: var(--usat-red); transform: translateX(3px); }
  .rzc-file-icon { width: 44px; height: 44px; border-radius: 4px; background: var(--usat-blue); display: grid; place-items: center; }
  .rzc-file-icon svg { width: 22px; height: 22px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .rzc-file strong { display: block; font-family: var(--font-heading); font-weight: 900; font-size: .98rem; line-height: 1.25; color: var(--usat-blue); }
  .rzc-file small { display: block; margin-top: 2px; font-size: .85rem; color: var(--usat-gray-mid); }
  .rzc-file-type { font-family: var(--font-light); font-size: .8rem; color: var(--usat-gray-mid); }

  /* ---------- Focus, motion, small screens ---------- */
  .rzc-hero a:focus-visible, .rzc-top a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .rzc-panel a:focus-visible, .rzc-panel button:focus-visible { outline: 3px solid var(--usat-blue); outline-offset: 3px; }

  @media (max-width: 900px) {
    .rzc-panel { grid-template-columns: 1fr; gap: 32px; padding: 24px; }
    .rzc-hero-in { padding: 56px 24px 128px; }
    .rzc-scrim { background: rgba(0,31,71,.80); }
    .rzc-top nav a { margin-left: 16px; }
  }
  @media (max-width: 480px) {
    .rzc-zones { --w: 34px; }
    .rzc-file { grid-template-columns: 44px 1fr; }
    .rzc-file-type { display: none; }
    .rzc-video-note { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rzc-photo, .rzc-zones i, .rzc-lanes path, .rzc-mk { animation: none; }
    .rzc-lanes path { stroke-dashoffset: 0; }
    .rzc-photo-wrap, .rzc-btn, .rzc-file, .rzc-play { transition: none; }
  }

  /* ---------- Swim photo framing ---------- */
  .rzc-hero { min-height: 760px; }
  .rzc-hero .rzc-photo {
    background-size: auto 100%; background-position: right center;
    -webkit-mask-image: linear-gradient(90deg, transparent 24%, #000 54%);
            mask-image: linear-gradient(90deg, transparent 24%, #000 54%);
  }
  .rzc-video { background-size: 170% auto; background-position: 90% 56%; }
  @media (max-width: 1000px) {
    .rzc-hero .rzc-photo { background-size: cover; background-position: 47% 50%; -webkit-mask-image: none; mask-image: none; }
  }
</style>
</head>
<body>
<div class="rzc">

  <header class="rzc-top">
    <div class="rzc-top-in">
      <a class="rzc-brand" href="#">USA Triathlon</a>
      <nav aria-label="On this page">
        <a href="#video">Video</a>
        <a href="#downloads">Downloads</a>
      </nav>
    </div>
  </header>

  <section class="rzc-hero" id="rzcHero">
    <div class="rzc-photo-wrap" id="rzcPhotoWrap">
      <div class="rzc-photo" role="img" aria-label="A triathlete diving off a floating dock into a lake"></div>
    </div>
    <div class="rzc-scrim"></div>

    <svg class="rzc-lanes" viewBox="0 0 1440 640" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <path style="--n:0" pathLength="1" d="M-60 590 C 180 560 380 620 640 590 S 1000 540 1240 560"/>
      <path style="--n:1" pathLength="1" d="M-60 622 C 200 594 400 654 660 624 S 1020 574 1270 596"/>
      <path style="--n:2" pathLength="1" class="lead" d="M-60 654 C 220 628 420 688 680 658 S 1040 608 1300 632"/>
      <path style="--n:3" pathLength="1" d="M-60 686 C 240 662 440 722 700 692 S 1060 642 1330 668"/>
    </svg>

    <div class="rzc-hero-in">
      <div class="rzc-copy">
        <h1>Swim Pace and Training Zone Calculator</h1>
        <p class="rzc-lede">Helping you plan your athletes' race pacing, training zones and swim sets for more accurate training and racing.</p>

        <p class="rzc-byline">By Justin Trollé, USA Triathlon Level 3 Coach</p>

        <div class="rzc-actions">
          <a class="rzc-btn rzc-btn-primary" href="#calculator">Swim Training, Technique and Pacing - Education</a>
          <a class="rzc-btn rzc-btn-ghost" href="#video">Watch the walkthrough</a>
        </div>

        <div class="rzc-zones" role="img" aria-label="Seven training zones, Zone 1 through Zone 7, with LT1 between Zones 2 and 3, CSS between Zones 4 and 5, and VO2 between Zones 6 and 7">
          <span style="--i:0;--h:14px;--o:.35"><i></i><b>Z1</b></span>
          <span style="--i:1;--h:21px;--o:.45"><i></i><b>Z2</b></span>
          <span style="--i:2;--h:28px;--o:.55"><i></i><b>Z3</b></span>
          <span style="--i:3;--h:36px;--o:.65"><i></i><b>Z4</b></span>
          <span style="--i:4;--h:45px;--o:.75"><i></i><b>Z5</b></span>
          <span style="--i:5;--h:55px;--o:.88"><i></i><b>Z6</b></span>
          <span style="--i:6;--h:66px;--o:1"><i></i><b>Z7</b></span>
          <u class="rzc-mk" style="--k:2;--bh:28px" aria-hidden="true"><b>LT1</b></u>
          <u class="rzc-mk" style="--k:4;--bh:45px" aria-hidden="true"><b>CSS</b></u>
          <u class="rzc-mk" style="--k:6;--bh:66px" aria-hidden="true"><b>VO2</b></u>
        </div>
      </div>
    </div>
  </section>

  <div class="rzc-wrap">
    <div class="rzc-panel">

      <section id="video" aria-labelledby="rzcVideoTitle">
        <h2 id="rzcVideoTitle">See it work</h2>
        <div class="rzc-video" id="rzcVideo">
          <button class="rzc-play" id="rzcPlay" type="button" aria-label="Play the walkthrough video">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5v17a1 1 0 0 0 1.5.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 6 3.5z"/></svg>
          </button>
          <p class="rzc-video-note" id="rzcVideoNote">Add your video link to VIDEO_URL at the bottom of this file.</p>
        </div>
        <p class="meta">Justin Trollé walks through a full calculator run.</p>
      </section>

      <section id="downloads" aria-labelledby="rzcDlTitle">
        <h2 id="rzcDlTitle">Take it with you</h2>
        <ul class="rzc-dl">
          <!-- Replace each href="#" with the link to your file -->
          <li>
            <a class="rzc-file" href="#" download>
              <span class="rzc-file-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg></span>
              <span><strong>7-zone training zones</strong><small>All seven zones from your calculator run.</small></span>
              <span class="rzc-file-type">PDF</span>
            </a>
          </li>
          <li>
            <a class="rzc-file" href="#" download>
              <span class="rzc-file-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg></span>
              <span><strong>LT1, CSS and VO2</strong><small>Your thresholds and VO2 on one sheet.</small></span>
              <span class="rzc-file-type">PDF</span>
            </a>
          </li>
          <li>
            <a class="rzc-file" href="#" download>
              <span class="rzc-file-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg></span>
              <span><strong>Swim pace and set design</strong><small>Turn your zones into sets and race pacing.</small></span>
              <span class="rzc-file-type">PDF</span>
            </a>
          </li>
          <li>
            <a class="rzc-file" href="#" download>
              <span class="rzc-file-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg></span>
              <span><strong>TrainingPeaks setup guide</strong><small>Bring your zones into TrainingPeaks, step by step.</small></span>
              <span class="rzc-file-type">PDF</span>
            </a>
          </li>
        </ul>
      </section>

    </div>
  </div>

  <!-- Put your calculator here -->
  <div id="calculator"></div>

</div>

<script>
  /* ============ SETTINGS: edit these two lines ============ */
  const VIDEO_URL  = "";   // YouTube, Vimeo or a direct .mp4 link
  const POSTER_URL = "";   // optional: your own thumbnail image for the video
  /* ========================================================= */

  // Video: click to load, so the page stays fast
  (function () {
    const box = document.getElementById("rzcVideo");
    const play = document.getElementById("rzcPlay");
    const note = document.getElementById("rzcVideoNote");
    if (POSTER_URL) box.style.backgroundImage = 'url("' + POSTER_URL + '")';
    if (VIDEO_URL) note.remove();

    function embed(url) {
      let m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
      if (m) return { tag: "iframe", src: "https://www.youtube-nocookie.com/embed/" + m[1] + "?autoplay=1&rel=0" };
      m = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
      if (m) return { tag: "iframe", src: "https://player.vimeo.com/video/" + m[1] + "?autoplay=1" };
      if (/\.(mp4|webm|mov)(\?|$)/i.test(url)) return { tag: "video", src: url };
      return { tag: "iframe", src: url };
    }

    play.addEventListener("click", function () {
      if (!VIDEO_URL) return;
      const e = embed(VIDEO_URL);
      const el = document.createElement(e.tag);
      el.src = e.src;
      if (e.tag === "iframe") {
        el.title = "Swim Pace and Training Zone Calculator walkthrough";
        el.allow = "autoplay; fullscreen; picture-in-picture";
        el.allowFullscreen = true;
      } else {
        el.controls = true; el.autoplay = true; el.playsInline = true;
      }
      box.appendChild(el);
      play.remove();
    });
  })();

  // Placeholder download links do nothing until you add real file URLs
  document.querySelectorAll('.rzc-file[href="#"]').forEach(function (a) {
    a.addEventListener("click", function (ev) { ev.preventDefault(); });
  });

  // Gentle photo parallax on mouse move (skipped for touch and reduced motion)
  (function () {
    const hero = document.getElementById("rzcHero");
    const wrap = document.getElementById("rzcPhotoWrap");
    if (!window.matchMedia("(hover: hover)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    hero.addEventListener("mousemove", function (e) {
      const r = hero.getBoundingClientRect();
      wrap.style.setProperty("--px", ((e.clientX - r.left) / r.width - .5) * -22 + "px");
      wrap.style.setProperty("--py", ((e.clientY - r.top) / r.height - .5) * -14 + "px");
    });
    hero.addEventListener("mouseleave", function () {
      wrap.style.setProperty("--px", "0px"); wrap.style.setProperty("--py", "0px");
    });
  })();
</script>
</body>
</html>
